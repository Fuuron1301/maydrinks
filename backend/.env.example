# Copy to backend/.env for local use. Never commit real passwords or keys.
APP_ENV=development
MAIL_MODE=file
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Windows Authentication: shared by init-db, Alembic, seed and the API.
# Use single quotes in .env so the instance backslash stays literal.
SQLSERVER_SERVER='(localdb)\MSSQLLocalDB'
# For SQL Server Express instead: SQLSERVER_SERVER='.\SQLEXPRESS'
SQLSERVER_DATABASE=MayDrinks

# SQL Authentication / remote SQL Server: a full ODBC string overrides both above.
# Create the target DB in SSMS first; do not run init-db with this setting.
# SQLSERVER_CONNECTION_STRING='DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost,1433;DATABASE=MayDrinks;UID=maydrinks_app;PWD=replace-locally;Encrypt=yes;TrustServerCertificate=yes;'
# For a public cloud server use trusted TLS: TrustServerCertificate=no.

# Optional later HTTPS deployment. Local submission does NOT require these.
# APP_ENV=production
# FRONTEND_URL=https://your-frontend-host
# CORS_ORIGINS=https://your-frontend-host
# MAIL_MODE=brevo
# BREVO_API_KEY=<set-in-hosting-secret-store>
# BREVO_SENDER_EMAIL=<verified-sender>
# Or MAIL_MODE=smtp with SMTP_HOST, SMTP_PORT=587, SMTP_FROM,
# SMTP_USER and SMTP_PASSWORD on a host permitting outbound SMTP.

# TEST_SQLSERVER_CONNECTION_STRING must point ONLY to a dedicated MayDrinksTest_* DB.
# Pytest resets all business tables in that test DB; never use production/demo data.
