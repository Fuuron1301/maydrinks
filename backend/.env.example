# Local defaults. Do not commit backend/.env or any real keys.
APP_ENV=development
MAIL_MODE=file
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://maydrinks.surge.sh

# Leave unset to use Windows LocalDB MayDrinks. For remote SQL use a secret env value:
# SQLSERVER_CONNECTION_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=tcp:your-server.database.windows.net,1433;DATABASE=MayDrinks;UID=your-user;PWD=your-secret;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;

# Render production values belong in its dashboard, not in this file:
# APP_ENV=production
# MAIL_MODE=brevo
# FRONTEND_URL=https://maydrinks.surge.sh
# CORS_ORIGINS=https://maydrinks.surge.sh
# BREVO_API_KEY=<set-in-dashboard>
# BREVO_SENDER_EMAIL=<verified-sender>

# Optional SMTP mode only on a host that allows outbound SMTP (not Render Free):
# MAIL_MODE=smtp
# SMTP_HOST=<smtp-host>
# SMTP_PORT=587
# SMTP_FROM=<verified-sender>
# SMTP_USER=<smtp-user>
# SMTP_PASSWORD=<set-secret>

# TEST_SQLSERVER_CONNECTION_STRING must point ONLY to a dedicated MayDrinksTest_* DB.
# Pytest resets all business tables in that DB; never use production/demo data.
